{
  "name": "hackarun-2026-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace Oficial de Engenharia para o 1º HackaRun UniCatólica 2026",
  "scripts": {
    "dev": "npm --prefix missao-2/app run dev",
    "build": "npm --prefix missao-2/app run build",
    "test:vitest": "npm --prefix missao-2/app run test",
    "test:python": "missao-2/backend/.venv/bin/python -m pytest -q missao-2/backend/tests",
    "test": "npm run test:vitest && npm run test:python",
    "open:canvas": "open docs/materiais-de-apoio/planejamento/canvas_executivo.html"
  }
}

