# Usado pelo docker-compose.yml. Copie para .env (cp .env.example .env) e ajuste. Nunca versione o .env.

# Porta do front no computador (troque se a 8080 já estiver em uso).
FRONTEND_PORT=8080

# Senha do Postgres do container (só existe dentro do Docker).
POSTGRES_PASSWORD=vitrineiq

# Login do admin (cria as contas dos lojistas). Sem as duas, não existe admin. Troque a senha.
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha

# Chave do HMAC que assina os tokens de login (mín. 32 caracteres). Vazia: a API gera uma a cada
# reinício (os logins caem quando o container reinicia). Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=

# Gemini (opcional): sem a chave, /api/ia/plano usa o fallback heurístico.
GEMINI_API_KEY=
GEMINI_MODEL=

# Token da câmera (computer-vision). Vazio: POST /api/vitrine/* aberto (só para rodar local).
VITRINE_TOKEN=

# Origens do CORS. O front do compose usa a mesma origem (nginx repassa /api), então só importa
# se outro front (ex.: npm run dev na porta 3000) chamar http://localhost:8000 direto.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
