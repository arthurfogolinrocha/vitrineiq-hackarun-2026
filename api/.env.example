# Copie para .env e preencha. Nunca versione o .env.

# Chave do Gemini (opcional): sem ela, /api/ia/plano usa o fallback heurístico.
GEMINI_API_KEY=
GEMINI_MODEL=

# Banco (opcional localmente: sem isso usa SQLite em api/vitrineiq.db).
# Em produção (Vercel) é obrigatório um Postgres, ex.: Neon ou Supabase.
DATABASE_URL=

# Origens liberadas no CORS, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:3000,https://vitrineiq-capim-dourado.vercel.app

# Regex de origens extras no CORS (previews da Vercel). Sem a variável, vale o padrão abaixo; vazia desliga a regex.
# Padrão: ^https://vitrineiq-capim-dourado-[a-z0-9]+-[a-z0-9-]+\.vercel\.app$
# ALLOWED_ORIGIN_REGEX=

# Token compartilhado com a câmera (computer-vision). Definido: POST /api/vitrine/* exige o
# cabeçalho X-Vitrine-Token igual, senão 401. Vazio: rotas abertas (só para desenvolvimento local).
# Em produção, defina na API e na câmera o mesmo valor (ex.: python -c "import secrets; print(secrets.token_urlsafe(32))").
VITRINE_TOKEN=
